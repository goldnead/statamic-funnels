includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src

    # Statamic's facades and the optional siblings are reached through
    # class_exists()-guarded seams and PHPDoc'd arrays; treating the doc types
    # as certain reports the guards themselves as "always false". Same setting
    # as in the other addons of the suite.
    treatPhpDocTypesAsCertain: false

    # Statamic 6 ships these two contracts without the methods the concrete
    # classes carry: `QueryBuilder` has `whereIn()` on every implementation
    # and `Entry` has `in()` on the Eloquent and Stache entries alike, but the
    # interfaces declare neither. Ignored here rather than rebuilt in a stub:
    # a stub would be a second copy of the Statamic API to keep in step.
    ignoreErrors:
        -
            message: '#Call to an undefined method Statamic\\Contracts\\Entries\\QueryBuilder::whereIn\(\)#'
            path: src/Http/Controllers/Cp/FunnelsController.php
        -
            message: '#Call to an undefined method Statamic\\Contracts\\Entries\\Entry::in\(\)#'
            path: src/Http/Controllers/Web/FunnelController.php

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub

    # The analytics addon is a `suggest`, not a `require`: the metrics under
    # src/Integrations/Insights extend its base class and implement its contract,
    # and it is not in vendor. Scanned from the test stand-ins — the same
    # declarations, byte for byte — so the metrics are checked against the real
    # signatures instead of being reported as unknown classes. Scanned, not
    # analysed: neither file is code this package ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php
        # spatie/browsershot is a `suggest` too; the renderer that drives it is
        # only constructed behind a class_exists guard.
        - tests/Fakes/browsershot.php
